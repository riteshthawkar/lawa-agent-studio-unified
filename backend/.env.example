# =============================================================================
# LAWA PLATFORM - Django Backend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env files with real credentials to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# CORE DJANGO SETTINGS
# -----------------------------------------------------------------------------
# Generate a secure key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-super-secret-key-change-this-in-production

# Debug mode - ALWAYS set to False in production
DEBUG=True

# Allowed hosts - comma separated list (e.g., "example.com,www.example.com")
ALLOWED_HOSTS=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL)
# -----------------------------------------------------------------------------
# Use SQLite for simple local development (set to true to skip PostgreSQL)
USE_SQLITE=False

# PostgreSQL connection settings
DB_NAME=lawa_platform
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432

# Alternative naming (also supported)
LAWA_DB_PG_DATABASE=lawa_platform
LAWA_DB_PG_USER=postgres
LAWA_DB_PG_PASSWORD=your-database-password
LAWA_DB_PG_HOST=localhost
LAWA_DB_PG_PORT=5432

# Connection pooling (optional, for production)
DB_CONN_MAX_AGE=600
DB_CONN_HEALTH_CHECKS=True
DB_ATOMIC_REQUESTS=False
DB_DISABLE_SERVER_SIDE_CURSORS=False

# Read replica (optional, for scaling)
# DB_REPLICA_HOST=
# DB_REPLICA_PORT=5432

# -----------------------------------------------------------------------------
# AUTHENTICATION & JWT
# -----------------------------------------------------------------------------
# JWT signing secret - use a strong, unique secret
AUTH_JWT_SECRET=your-jwt-signing-secret-change-this

# Token lifetimes (in seconds)
AUTH_JWT_ACCESS_TOKEN_LIFETIME=86400        # 24 hours
AUTH_JWT_REFRESH_TOKEN_LIFETIME=604800      # 7 days

# -----------------------------------------------------------------------------
# CORS CONFIGURATION
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins (full URLs with protocol)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Allow credentials (cookies, authorization headers)
CORS_ALLOW_CREDENTIALS=True

# Regex patterns for allowed origins (optional)
# CORS_ALLOWED_ORIGIN_REGEXES=

# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION
# -----------------------------------------------------------------------------
# Email backend - use 'console' for development, 'smtp' for production
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP settings (for production)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-specific-password

# Default sender address
DEFAULT_FROM_EMAIL=noreply@lawa.app

# -----------------------------------------------------------------------------
# SECURITY SETTINGS (Production)
# -----------------------------------------------------------------------------
# Webhook signing secret - for verifying webhook authenticity
WEBHOOK_SIGNING_SECRET=your-webhook-signing-secret

# Session settings
SESSION_COOKIE_SECURE=False          # Set to True in production with HTTPS
CSRF_COOKIE_SECURE=False             # Set to True in production with HTTPS
SESSION_COOKIE_HTTPONLY=True
CSRF_COOKIE_HTTPONLY=True

# -----------------------------------------------------------------------------
# CHATBOT INTEGRATION
# -----------------------------------------------------------------------------
# Pinecone vector database
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=lawa-website-index

# Default embedding model
CHATBOT_DEFAULT_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# -----------------------------------------------------------------------------
# EXTERNAL SERVICES
# -----------------------------------------------------------------------------
# Website Indexing Backend URL (for triggering indexing jobs)
INDEXING_BACKEND_URL=http://localhost:8080

# Indexing API token (shared secret for backend-to-backend auth)
INDEXING_API_TOKEN=your-indexing-api-token

# Embedded Chatbot Backend URL
CHATBOT_BACKEND_URL=http://localhost:8002

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST_SIZE=10

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/django.log

# -----------------------------------------------------------------------------
# AWS (Optional - for production secret management)
# -----------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# -----------------------------------------------------------------------------
# TEST CONFIGURATION
# -----------------------------------------------------------------------------
# Base URL for API tests
TEST_API_BASE=http://127.0.0.1:8000
